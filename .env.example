# Pass an authenticated GitHub token at startup. It is exchanged for a
# short-lived runner token and never baked into the image.
GITHUB_TOKEN=
RUNNER_NAME=

# Published GHCR image tag to run. The default tracks the latest main build.
IMAGE_TAG=latest

# Comma-separated custom labels advertised by each runner.
RUNNER_LABELS=ubuntu-24.04

# Keep this pinned to a tested GitHub Actions runner release.
RUNNER_VERSION=2.328.0

# .NET SDK release channel installed in the image.
DOTNET_CHANNEL=10.0

# Pinned Go release installed in the image.
GO_VERSION=1.26.5

# Latest Node.js release installed in the image.
NODE_VERSION=26.5.1
